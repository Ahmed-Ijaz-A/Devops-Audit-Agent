# Copy this file to .env (git-ignored) or set these as environment variables; never commit a real API key.

# Provider: openai (default), gemini, groq, openrouter, or ollama.
LLM_PROVIDER=openai
# Optional: overrides the provider's default model.
LLM_MODEL=

# Set the key for the provider you chose.
OPENAI_API_KEY=replace-me
GEMINI_API_KEY=replace-me
GROQ_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me

# Optional: comma-separated models to switch to if the main one stays overloaded or unavailable.
LLM_FALLBACK_MODELS=

# Optional: minimum seconds between LLM requests (useful on free tiers, e.g. 6).
LLM_MIN_INTERVAL=0
